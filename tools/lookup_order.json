{
  "type": "webhook",
  "name": "lookup_order",
  "description": "Looks up a NovaMart order by its order ID and returns its status, items, and expected delivery date. Call it only after the caller has given an order ID and you have repeated it back to confirm it. If the result has status not_found, tell the caller the order could not be found and ask them to check the ID. Never read a full shipping address aloud.",
  "api_schema": {
    "url": "https://certification-elevenlabs.vercel.app/api/lookup_order",
    "method": "POST",
    "path_params_schema": [],
    "query_params_schema": [],
    "request_body_schema": {
      "id": "body",
      "type": "object",
      "description": "The order the caller wants to look up.",
      "required": true,
      "properties": [
        {
          "id": "order_id",
          "type": "string",
          "description": "The order ID the caller said, digits only with no spaces or dashes, for example 12345. Confirm it with the caller before calling.",
          "dynamic_variable": "",
          "constant_value": "",
          "value_type": "llm_prompt",
          "required": true
        }
      ],
      "value_type": "llm_prompt"
    },
    "request_headers": [],
    "content_type": "application/json",
    "auth_connection": null,
    "mtls_auth_connection": null,
    "mtls_on_token_request": false,
    "response_filter": null
  },
  "response_timeout_secs": 20,
  "follow_redirects": false,
  "follow_redirects_allowed_domains": [],
  "dynamic_variables": {
    "dynamic_variable_placeholders": {}
  },
  "assignments": [
    {
      "dynamic_variable": "order_status",
      "value_path": "status",
      "sanitize": true,
      "preserve_native_type": true
    },
    {
      "dynamic_variable": "current_order_id",
      "value_path": "order_id",
      "sanitize": true,
      "preserve_native_type": true
    }
  ],
  "interruption_mode": "allow",
  "pre_tool_speech": "auto",
  "tool_call_sound": null,
  "tool_call_sound_behavior": "auto",
  "execution_mode": "immediate",
  "tool_error_handling_mode": "auto",
  "response_mocks": []
}
